# =====================================================================
# Supabase Configuration
# =====================================================================
# Crie seu projeto em https://supabase.com e preencha estas variáveis.
# NUNCA commite o arquivo .env real (apenas .env.example).
# =====================================================================

# URL pública do projeto Supabase
SUPABASE_URL=https://seu-projeto.supabase.co

# Anon key (público, enviado ao frontend - protegido por RLS)
SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key (SECRETO - apenas backend/Edge Functions, NUNCA frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# =====================================================================
# Frontend (Angular)
# =====================================================================
# Estas duas variáveis são expostas ao bundle (build-time).
# Em Angular, prefixe NG_APP_ e use em environment.ts.
NG_APP_SUPABASE_URL=https://seu-projeto.supabase.co
NG_APP_SUPABASE_ANON_KEY=eyJhbGciOi...
