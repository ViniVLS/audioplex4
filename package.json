{
  "name": "audioplex4",
  "version": "1.0.4",
  "description": "AudioPlex4 - Extraia e ouça áudios em alta qualidade",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "nodemon server/server.js",
    "dev:frontend": "cd frontend && ng serve --proxy-config proxy.conf.json",
    "build": "cd frontend && ng build && cd .. && rm -rf public && mkdir public && cp -r frontend/dist/frontend/* public/",
    "deploy": "npm run build && npm start",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android:prepare": "node scripts/write-env.cjs && cd frontend && ng build --configuration production && cd .. && npx cap sync android && node scripts/prepare-android.cjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/filesystem": "^7.1.8",
    "@distube/ytdl-core": "^4.16.4",
    "axios": "^1.7.9",
    "compression": "^1.8.1",
    "concurrently": "^10.0.5",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ffmpeg-static": "^5.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "fs-extra": "^11.2.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.0",
    "play-dl": "^1.9.7",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "@angular/cli": "^21.2.22",
    "@playwright/test": "^1.62.1",
    "chokidar": "^5.0.0",
    "nodemon": "^3.1.0",
    "typescript": "~5.9.2"
  }
}
